# Copy to group_vars/all.yml and fill in real values.
# group_vars/all.yml is gitignored — never commit it.

traefik_version: "v3.7.13"
acme_email: "admin@example.com"
proxy_network_name: proxy
deploy_path: /opt/traefik

# Set to false if Docker is already installed on the target host.
install_docker: true

# Traefik's own dashboard, routed through Traefik itself and gated by
# basic auth. Leave disabled unless you set dashboard_auth_users below.
enable_dashboard: false
dashboard_domain: "traefik.example.com"

# Generate with: htpasswd -nB <user>
dashboard_auth_users:
  - "user:$apr1$replace$with-your-htpasswd-hash"
